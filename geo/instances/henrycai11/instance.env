# GEO instance: Min Cai's academic homepage. Data/config only; no site-specific code.
GEO_SITE_REPO=/scratch/henrycai/HenryCai11.github.io
GEO_SITE_URL=https://henrycai11.github.io/
GEO_BUILDER=jekyll
GEO_DEPLOY_BRANCH=master
# Out-of-distribution signal (real traffic); the token stays in the file.
GEO_GOATCOUNTER=henrycai11
GEO_GOATCOUNTER_TOKEN_FILE=~/.config/goatcounter/token
# Files the loop may edit (comma-separated; directories end in /).
GEO_EDITABLE=_pages/about.md,_pages/cv.md,_config.yml,_layouts/default.html,_layouts/home.html,_includes/geo-head.html,llms.txt,robots.txt,papers/
# Average two LLM replies per evaluation to damp noise.
GEO_EVAL_ARGS="--samples 2"
