# GEO instance for the EAU project website. Keep this scorer outside the site repo.
GEO_SITE_REPO=/workspace/eau-geo-benchmark-followup
GEO_SITE_URL=https://eau-meta-agent.github.io/
GEO_BUILDER=static
GEO_DEPLOY_BRANCH=main
GEO_EDITABLE=index.html,research-context.html,styles.css,script.js,site-config.js,llms.txt,robots.txt,sitemap.xml
GEO_EVAL_ARGS="--no-llm --probes /workspace/henry-autoresearch-wrapper/geo/instances/eau/probes.jsonl"
